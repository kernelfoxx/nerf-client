# --- Telegram bot ---
# Token from @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Optional public bot username, used in messages
BOT_USERNAME=NerfGramBot

# --- Public address of this server ---
# Pterodactyl gives you an IP and a port. The bot sends this address to users.
# If you put Cloudflare/Nginx in front, use the https://domain here instead.
PUBLIC_BASE_URL=http://1.2.3.4:8080
PORT=8080
HOST=0.0.0.0

# --- Secret for activation keys and payload signatures ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- BIP39 seed for receiving crypto addresses ---
# Generate: python scripts/generate_seed.py
# BACK IT UP OFFLINE. Anyone with this phrase controls the funds.
# Leave empty to disable crypto payments (the site will show only Telegram Stars).
WALLET_SEED="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# --- Prices ---
# Telegram Stars: 7 days = $2 -> 200 XTR, 30 days = $4 -> 400 XTR (1 XTR ~= $0.01)
STARS_PRICE_7=200
STARS_PRICE_30=400
# Indicative USD rates used to display crypto amounts.
CRYPTO_RATES_JSON={"BTC":95000,"TON":5.5,"USDT":1}

# --- Payments ---
# Crypto is verified automatically from public explorers; no admin/seller confirmation exists.
# false disables automatic checks (payments stay pending until you enable it again).
CRYPTO_AUTO_CHECK=true
CRYPTO_MIN_CONFIRMATIONS=1
# Token contracts used when parsing transfers
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
ETHERSCAN_API_KEY=

# --- Storage ---
DB_PATH=data/nerfgram.sqlite3
LOG_LEVEL=INFO
